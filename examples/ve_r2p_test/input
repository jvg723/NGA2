# Parallelization
Partition : 8 1 1

# Mesh definition
Lx : 5.25e-3
Ly : 5.25e-3
Lz : 5.25e-6
nx : 150
ny : 150
nz : 1


# Droplet properties
Droplet radius :        2e-3
Initial contact angle : 180

# Pipette information
Include pipette :           .false.  #<<< Provided in the command line
Pipette height :            3.0e-3
Pipette inner radius :      1.0-3
Pipette outer radius :      1.5e-3


# Source
Gravity : 0 -9.81 0

# Fluid properties
Liquid dynamic viscosity : 9.0e-4
Gas dynamic viscosity :    1.8e-5

Liquid density : 997
Gas density :    1.15

Surface tension coefficient : 0.072
Static contact angle : 30.0   

# Time integration
Max timestep size : 1e-4
Max cfl number :    0.9
Max time :          0.2

# Pressure solver
Pressure tolerance : 1e-6
Pressure iteration : 100

# Implicit velocity solver
Implicit tolerance : 1e-6
Implicit iteration : 100

# Ensight output
Ensight output period : 1e-3

# Post-processing output
Postproc output period : 1e-3
